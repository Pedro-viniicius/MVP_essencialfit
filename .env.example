# Para só conferir a interface, nada disto é necessário: o modo de teste sobe o
# projeto com dados fictícios em memória. Ver MOCKS.md.
# USAR_MOCKS=false desliga o modo de teste e volta a exigir o que está abaixo.

# ---- Banco de dados (Neon) ----
# String de conexão do Neon (Vercel Marketplace injeta DATABASE_URL automaticamente).
DATABASE_URL=
# URL pública canônica: metadados da landing (canonical, OpenGraph), cupom e mensagens.
NEXT_PUBLIC_SITE_URL=https://essencial-fit.vercel.app
# ---- Segurança ----
# Sal para o hash do IP. Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-por-um-valor-aleatorio-longo
# Segredo para assinar o cookie de sessão do /admin. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Limite de cadastros por IP (hash). Padrão: 5 por minuto e 30 por hora.
# Atenção: um tablet de balcão (?o=manual) conta como um único IP.
LIMITE_POR_MINUTO=5
LIMITE_POR_HORA=30

# ---- Admin ----
# Senha forte do painel /admin (mínimo 16 caracteres).
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-16-ou-mais
# Chave TOTP em base32. Gere com: pnpm totp:enroll (só gera se estiver vazia;
# --rotate para trocar). Cadastre no app autenticador. Ver docs/admin-acesso.md.
ADMIN_TOTP_SECRET=
